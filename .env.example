# Copy to .env and fill in. .env is gitignored; never commit real values.

APP_ENV=development
DATABASE_URL=sqlite:///data/taskpilot.db

# Groq (every LLM call goes here). Create a key at console.groq.com.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAIN_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# JWT signing secret. Generate one with: python -m scripts.gen_secret
# If left empty in development, a random one is used and logins reset on restart.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Email: mailpit (local test inbox, default) or gmail (real sending, off by default).
EMAIL_BACKEND=mailpit
# Comma-separated. Applies to the gmail backend only. Empty blocks ALL gmail sends.
EMAIL_ALLOWLIST=
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Demo organization
ORG_DOMAIN=acme.example.com
TIMEZONE=Asia/Kolkata
